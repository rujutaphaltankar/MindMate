# ──────────────────────────────────────────────────────────────────────────────
# MindMate AI -- Backend Environment Variables
# Copy this file to .env and fill in real values before running the server.
# NEVER commit a real .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# --- Database ---
MONGO_URI=mongodb://localhost:27017/mindmate_ai

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Rate Limiting ---
# Leave as memory:// for local dev. Use Redis URI in production e.g. redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# --- Email -- Provider 1: Resend (recommended) ---
# Sign up free at https://resend.com (3 000 emails/month free tier).
# Set MAIL_FROM to an address on your verified Resend domain.
# For quick testing you can use: MAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=
MAIL_FROM=noreply@yourdomain.com

# --- Email -- Provider 2: SMTP fallback (Gmail / SendGrid / Outlook) ---
# Only used when RESEND_API_KEY is empty.
# Gmail: enable 2FA, create an App Password at myaccount.google.com/apppasswords
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-app-password

# --- AI Provider ---
# rule_based  -- works without an API key (default)
# anthropic   -- requires ANTHROPIC_API_KEY
# openai      -- requires OPENAI_API_KEY
AI_PROVIDER=rule_based
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
